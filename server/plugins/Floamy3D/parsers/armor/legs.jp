match *:*left_legs* *:*left_leg*
rotatesc y -90
rotate x 90
rotatesc z -90
translatesc -12 0 0
cube *
switchface east west
flipface south

match *:*right_legs* *:*right_leg*
rotatesc y 90
rotate x 90
rotatesc z -90
translatesc -12 0 0
cube *
switchface east west
flipface south


match *:*waist* *inner_body*
rotatesc y 90
rotate x 90
rotatesc z -90
translatesc -12 0 0
cube *
switchface east west
flipface south