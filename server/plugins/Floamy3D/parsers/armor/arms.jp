match *:*left_arms* *:*left_arm*
rotatesc y -90
rotate x 90
rotatesc z -90
translatesc -12 0 0
cube *
flipupf
switchface east west
flipface south
switchface up down
flipface up
flipface down
childrotmul x -1
childrotmul y -1

match *:*right_arms* *:*right_arm*
rotatesc y 90
rotate x 90
rotatesc z -90
translatesc -12 0 0
cube *
switchface east west
flipface south
switchface up down
flipface up
flipface down