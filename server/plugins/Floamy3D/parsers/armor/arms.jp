match *:*left_arms* *:*left_arm*
rotatesc y -90
rotate x 90
rotatesc z -90
translatesc -12 0 0
rotatechilds x 90
rotatechilds y 90
cube *

switchface east west
flipface south
switchface up down
flipface up
flipface down

match *:*right_arms* *:*right_arm*
rotatesc y 90
rotate x 90
rotatesc z -90
translatesc -12 0 0
cube *
switchface east west
flipface south
switchface up down
flipface up
flipface down
